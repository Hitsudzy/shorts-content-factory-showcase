# Copy to .env (never commit) and fill in. Only placeholders here.

# Root of the factory checkout the scripts resolve paths against.
# In this snapshot the factory root is the `core/` directory.
FACTORY_ROOT=core

# YouTube Data API v3 key used by the trend hunter (public data only).
YOUTUBE_API_KEY=

# Publisher: paths (never the secrets themselves) outside any git working tree.
PUBLISHER_CLIENT_SECRET_FILE=~/.config/content-factory/publisher/client_secret.json
PUBLISHER_TOKEN_FILE=~/.config/content-factory/publisher/oauth-token.json
PUBLISHER_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx
