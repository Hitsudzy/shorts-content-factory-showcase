#!/usr/bin/env python3
"""CF-0107: the operator marker command. `runlog batch-start|stage-start|
stage-done|batch-done <stage> [--batch DIR] [--note ...]`, `runlog render`,
`runlog tail`. Thin shim over shared/runlog/runlog.py; put scripts/ on PATH
or call it as <root>/scripts/runlog."""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "shared" / "runlog"))
import runlog  # noqa: E402

sys.exit(runlog.main())
