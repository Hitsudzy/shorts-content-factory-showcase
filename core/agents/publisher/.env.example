# Publisher (CF-0421) - copy to agents/publisher/.env (gitignored) and fill in.
# Only PATHS go here, never the secrets themselves. Both files must lie OUTSIDE
# any git working tree - upload.py refuses a path inside one.

# OAuth client of type "Desktop app" downloaded from Google Cloud Console
# (APIs & Services -> Credentials). A JSON file; keep it chmod 600.
PUBLISHER_CLIENT_SECRET_FILE=~/.config/content-factory/publisher/client_secret.json

# Where upload.py --authorize saves the refresh token (written chmod 600).
PUBLISHER_TOKEN_FILE=~/.config/content-factory/publisher/youtube.oauth-token.json

# The channel the token must belong to. Public, not a secret.
# upload.py compares it with channels.list(mine=true) before every upload.
PUBLISHER_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx

# YouTube category (24 = Entertainment) and the language of title/description/audio.
PUBLISHER_CATEGORY_ID=24
PUBLISHER_LANGUAGE=en

# CF-0607: the OAuth app's publishing status in Google Auth Platform - testing
# (default) or production. Set production only after Audience -> Publish app
# then re-authorize: a Production token has no fixed
# term (it lives until revoked or unused for six months).
PUBLISHER_OAUTH_MODE=testing

# CF-0589: in Testing Google keeps the refresh token for 7 days after the
# consent; `publisher_auth.py status` warns this many hours before. Testing only.
PUBLISHER_TOKEN_LIFETIME_DAYS=7
PUBLISHER_TOKEN_REMIND_HOURS=24
# CF-0652: `publisher_auth.py status --needs-you` asks its question in the journal of
# questions (shared/needs_you.py, <root>/needs-you or $NEEDS_YOU_DIR) - no vault file.
